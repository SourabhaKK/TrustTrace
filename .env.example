# Copy to .env and adjust. Never commit real secrets.

# OTLP endpoint of the Foundry-installed SigNoz (gRPC). From Windows against SigNoz
# running in WSL2 this is typically http://localhost:4317; otherwise the WSL2 IP.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Logical environment tag attached to every span (service.name is fixed to "trusttrace").
OTEL_ENV=local

# Optional local toggles:
# OTEL_CONSOLE_EXPORT=1   # also print spans to the console
# OTEL_DISABLE_OTLP=1     # skip OTLP export entirely (offline tests)
