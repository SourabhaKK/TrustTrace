data
models
mlruns
mlflow.db
*.parquet
*.csv

# Foundry / infra
pours
casting.yaml
casting.yaml.lock

# Docs, tests, eval outputs (not shipped in the serving image)
docs
tests
artifacts/eval_results.md
artifacts/eval_metrics.json
