# Data & model artifacts (regenerated by the pipeline; never committed — see CLAUDE.md scope)
data/*
!data/.gitkeep
models/
mlruns/
mlflow.db
*.parquet
*.csv

# LoRA adapter: commit ONLY the two files PEFT needs (~17 MB, no LFS). The base tokenizer,
# chat template, and auto-generated README in artifacts/adapter/ are redundant/re-downloadable.
artifacts/adapter/*
!artifacts/adapter/adapter_config.json
!artifacts/adapter/adapter_model.safetensors

# Foundry deployment artifacts (casting.yaml, casting.yaml.lock, pours/) ARE committed
# as the graded reproducibility artifact (FR7) — judges re-run Foundry against them.
# Foundry also drops an examples/ tree during install — not part of this repo.
docs/examples/

# OS / editor
.DS_Store
.idea/
.vscode/
